# spawn: -560,30,530,-1.57
# Vegetation LOD cross-fades (render/LodFade.js): the shader picks each instance's LOD from its
# distance to camPosW, the CPU only picks which sectors (or 16 m cells of a sector a near LOD's ring
# cuts through: InstancedField `sub`) each LOD mesh holds. camPosW must follow the camera (small
# plants and grass fade with it), and every instance in view must be in the mesh of each LOD whose
# range contains it, or it shows a hole in the middle of a blend band.
wait 2
eval (()=>{ const w = app.world, U = app.engine.lighting.uniforms.camPosW.value; const out = { camErr: +U.distanceTo(app.engine.camera.position).toFixed(2), near: w.vegetation.fieldNear.stats.instances, checked: 0, inBand: 0, holes: 0 }; for (const f of [w.vegetation.fieldNear, w.vegetation.fieldFar]) { const n = f.n, nn = n * n, S = f.sector, x0 = f.x0, z0 = f.z0; const vis = new Set(); for (let i = 0; i < f._vis.length; i += 4) vis.add(f._vis[i]); for (let i = 0; i < f.count; i++) { const it = { kind: f._kv[i * 2], variant: f._kv[i * 2 + 1], matrix: f._mat.subarray(i * 16, i * 16 + 16) }; const k = f.kinds[it.kind]; if (!k.scaled) continue; const cx = Math.min(n - 1, Math.max(0, Math.floor((it.matrix[12] - x0) / S))), cz = Math.min(n - 1, Math.max(0, Math.floor((it.matrix[14] - z0) / S))); const sec = cz * n + cx; if (!vis.has(sec)) continue; const SB = f.sub ?? 1, C = S / SB, gx = Math.min(n * SB - 1, Math.max(0, Math.floor((it.matrix[12] - x0) / C))), gz = Math.min(n * SB - 1, Math.max(0, Math.floor((it.matrix[14] - z0) / C))); const cell = sec * SB * SB + (gz % SB) * SB + (gx % SB); const d = Math.hypot(it.matrix[12] - U.x, it.matrix[14] - U.z); k.scaled.forEach((r, li) => { if (d < r[0] || d >= r[3]) return; out.checked++; if (d < r[1] || d > r[2]) out.inBand++; const b = k.variants[it.variant].meshes[li].userData.blocks; if (!b?.has(it.variant * nn + sec) && !b?.has(2 ** 30 + it.variant * nn * SB * SB + cell)) out.holes++; }); } } window.__lod = out; return out })()
expect window.__lod.camErr < 2
expect window.__lod.near > 0
expect window.__lod.checked > 200 && window.__lod.inBand > 0
expect window.__lod.holes === 0
shot lod_fade
