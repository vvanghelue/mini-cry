# Streaming stress: fly low across the island at 30 m/s (108 km/h) for 8 s while recording every
# rendered frame: its CPU time (JS + encoding the GPU work) p99 under 10 ms and no frame interval
# over 33 ms (no hitch when terrain LODs / vegetation sectors / grass tiles / props stream in:
# uploads are incremental, shaders compiled at loading). Not the rAF intervals: without vsync,
# Chrome presents WebGPU canvases in bursts (a few fast frames, then a ~18 ms wait on the Metal
# queue), which says nothing about hitches.
eval (()=>{ const g = game; g.player.godMode = true; g.player.godInvisible = true; g.player.noclip = true; g.player.pos.set(-600, 40, 300); g.player.yaw = -Math.PI / 2 - 0.3; g.player.pitch = -0.08; window.__ft = []; window.__cpu = []; { const p = app.engine.perf, prev = p.onFrame; p.onFrame = (c, fm) => { window.__cpu.push(c); window.__ft.push(fm); prev?.(c, fm); }; } const t0 = performance.now(); const f = (t) => { const k = (t - t0) / 1000; const x = -600 + k * 30 * Math.cos(0.3), z = 300 - k * 30 * Math.sin(0.3); g.player.pos.set(x, g.world.terrain.heightAt(x, z) + 12, z); if (k < 8) requestAnimationFrame(f); }; requestAnimationFrame(f); return 1 })()
wait 8.5
eval (()=>{ const a = window.__ft.slice(10).sort((x, y) => x - y), c = window.__cpu.slice(10).sort((x, y) => x - y); const q = (a, p) => +a[Math.floor(a.length * p)].toFixed(2); return { frames: a.length, p50: q(a, 0.5), p95: q(a, 0.95), p99: q(a, 0.99), max: +a[a.length - 1].toFixed(1), cpuP50: q(c, 0.5), cpuP99: q(c, 0.99), cpuMax: +c[c.length - 1].toFixed(1), travelled: Math.round(game.player.pos.distanceTo(new app.THREE.Vector3(-600, game.player.pos.y, 300))) } })()
expect (()=>{ const a = window.__ft.slice(10).sort((x, y) => x - y), c = window.__cpu.slice(10).sort((x, y) => x - y); return c[Math.floor(c.length * 0.99)] < 10 && a[a.length - 1] < 33 })()
