# Streaming stress: fly low across the island at 30 m/s (108 km/h) for 8 s while recording every
# frame time; p99 under 10 ms and no frame over 33 ms (no hitch when terrain LODs / vegetation
# sectors / grass tiles / props stream in: uploads are incremental, shaders compiled at loading).
eval (()=>{ const g = game; g.player.godMode = true; g.player.godInvisible = true; g.player.noclip = true; g.player.pos.set(-600, 40, 300); g.player.yaw = -Math.PI / 2 - 0.3; g.player.pitch = -0.08; window.__ft = []; let last = performance.now(); const t0 = last; const f = (t) => { window.__ft.push(t - last); last = t; const k = (t - t0) / 1000; const x = -600 + k * 30 * Math.cos(0.3), z = 300 - k * 30 * Math.sin(0.3); g.player.pos.set(x, g.world.terrain.heightAt(x, z) + 12, z); if (k < 8) requestAnimationFrame(f); }; requestAnimationFrame(f); return 1 })()
wait 8.5
eval (()=>{ const a = window.__ft.slice(10).sort((x, y) => x - y); const q = (p) => +a[Math.floor(a.length * p)].toFixed(2); return { frames: a.length, p50: q(0.5), p95: q(0.95), p99: q(0.99), max: +a[a.length - 1].toFixed(1), over8ms: a.filter((x) => x > 8.3).length, travelled: Math.round(game.player.pos.distanceTo(new app.THREE.Vector3(-600, game.player.pos.y, 300))) } })()
expect (()=>{ const a = window.__ft.slice(10).sort((x, y) => x - y); return a[Math.floor(a.length * 0.99)] < 10 && a[a.length - 1] < 33 })()
