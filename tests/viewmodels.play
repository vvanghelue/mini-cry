# First-person models: every weapon has its realistic model (public/models/fp, `mc viewmodel build`)
# and the arms (Rocketbox, two-bone IK) put both wrists on its grips, at the hip and aiming.
# The pose is set directly (independent of the frame rate), as Weapons._animateVM places it.
# spawn: -505,2,525,0.6
expect !!game.weapons.arms && Object.keys(game.data.weapons.weapons).every((id) => !!game.viewModels.weapons[game.data.weapons.weapons[id].asset])
eval (() => { const w = game.weapons, V = app.THREE.Vector3, out = {}; for (const id of Object.keys(w.defs)) { const d = w.defs[id], view = d.view ?? { pos: [0.2, -0.25, -0.5], rot: [0, 0, 0] }; w._showVM(id); for (const ads of [0, 1]) { const info = w.vmInfo; w.vmRoot.position.set(...view.pos).lerp(new V(-info.sight.x, -info.sight.y, -(view.adsDist ?? 0.32)), ads); w.vmRoot.rotation.set(view.rot[0] * Math.PI / 180, view.rot[1] * Math.PI / 180 * (1 - ads), view.rot[2] * Math.PI / 180 * (1 - ads)); w.vm.camera.updateMatrixWorld(true); w.arms.update(w.vmGroup, info.hands); for (const k of Object.keys(info.hands ?? {})) { const t = new V(...info.hands[k].pos).applyMatrix4(w.vmGroup.matrixWorld); out[`${id}${ads ? '_ads' : ''}_${k}`] = +w.arms.sides[k[0].toUpperCase()].wrist.getWorldPosition(new V()).distanceTo(t).toFixed(4); } } } window.__gripErrors = out; return out; })()
expect Object.values(window.__gripErrors).every((e) => e < 0.01)
# the view-model camera follows the world camera: the arms' pose (elbows) must not change when the view turns
eval (() => { const w = game.weapons, V = app.THREE.Vector3, E = app.THREE.Euler, cam = w.vm.camera; w._showVM('rifle_ak'); const pose = (yaw, pitch) => { cam.quaternion.setFromEuler(new E(pitch, yaw, 0, 'YXZ')); cam.updateMatrixWorld(true); w.arms.update(w.vmGroup, w.vmInfo.hands); return ['L', 'R'].map((k) => cam.worldToLocal(w.arms.sides[k].lower.getWorldPosition(new V()))); }; const a = pose(0, 0), d = [[1.6, 0], [3.1, -0.3], [4.7, 0.4]].map(([y, p]) => Math.max(...pose(y, p).map((e, i) => e.distanceTo(a[i])))); window.__elbowDrift = Math.max(...d); return window.__elbowDrift; })()
expect window.__elbowDrift < 0.002
